   <string notr="true">/* style.qss */
QWidget {
  background: #F3F6FA;
  color: #1F2D3D;
  font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, sans-serif;
  font-size: 10pt;
}

/* Sidebar */
QFrame#sideBar {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #0D3B73, stop:1 #1E5AA8);
  color: white;
}
QLabel#labelTitle {
  color: white;
  font-weight: 700;
  font-size: 14pt;
}

/* Header */
QLabel#labelModule {
  color: #1F2D3D;
  font-size: 14pt;
  font-weight: 600;
}

/* Buttons */
QPushButton {
  background: white;
  border: 1px solid #D3DCE6;
  border-radius: 6px;
  padding: 6px 10px;
}
QPushButton#btnAdd {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2DBE5A, stop:1 #1DA14A);
  color: white;
  border: none;
}
QPushButton#exportBtn, QPushButton#matchmakingBtn {
  background: #E9EEF5;
}

/* Table */
QTableWidget {
  background: white;
  border: 1px solid #E6EDF5;
  gridline-color: #F0F2F6;
  selection-background-color: #DDEBF7;
}

/* Search field */
QLineEdit#editSearch {
  border: 1px solid #D3DCE6;
  border-radius: 6px;
  padding: 6px;
}

/* Small action buttons used inside table row */
QPushButton.rowButton {
  min-width: 70px;
  max-height: 26px;
  padding: 3px;
}
</string>
